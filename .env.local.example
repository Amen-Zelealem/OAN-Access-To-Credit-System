API_BASE_URL=
NEXT_PUBLIC_API_MOCKING=false

# Single sign-on (Development Agents and farmers) needs no settings here: the
# login options come from oan_auth_service (GET /v1/auth/iam/providers), which
# also starts, refreshes and ends IAM sessions. The browser never calls an IAM.
# What it does need, outside this file:
#   - this app served under the same parent domain as the IAMs, so their
#     cookies reach this server;
#   - this app's origin (e.g. https://a2c.example.org) in `return_origins` on
#     every OAN IAM Service row it offers, set by a System Manager in
#     oan_auth_service.
